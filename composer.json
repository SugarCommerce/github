{
    "name": "sugarcommerce/github",
    "version": "1.1.0",
    "description": "The GitHub calls for selling access to private repositories: a GitHub App's RS256 JWT and installation tokens, user sign-in with PKCE that handles GitHub's 200-with-an-error answer, and collaborator invitations kept by numeric id rather than by a login that can be renamed.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/sugarcommerce/github",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "github",
        "github-app",
        "jwt",
        "oauth",
        "pkce",
        "collaborators",
        "repository-access"
    ],
    "require": {
        "php": ">=8.5",
        "sugarcommerce/http-client": "^1.2",
        "sugarcommerce/signed-tokens": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Github\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Github\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/github/issues",
        "source": "https://github.com/sugarcommerce/github"
    }
}
